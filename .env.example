# Copy to .env and fill in real values. .env is gitignored.

# --- Database ---
# Host access (running scripts from the host against the mapped port):
DATABASE_URL=postgresql+psycopg://dev:password@localhost:5432/data_engineering_agent
POSTGRES_DB=data_engineering_agent
POSTGRES_USER=dev
POSTGRES_PASSWORD=password

# --- AI (Gemini) ---
GEMINI_API_KEY=your_key_here
# Model ids (current generation). Override per-task as needed.
GEMINI_PLANNER_MODEL=gemini-2.5-flash
GEMINI_EXECUTOR_MODEL=gemini-2.5-flash

# --- GitHub (later phases) ---
GITHUB_TOKEN=
