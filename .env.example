# Copy to .env and fill in real values. .env is gitignored.

# --- Database ---
# Host access (running scripts from the host against the mapped port):
DATABASE_URL=postgresql+psycopg://dev:password@localhost:5432/data_engineering_agent
POSTGRES_DB=data_engineering_agent
POSTGRES_USER=dev
POSTGRES_PASSWORD=password

# --- AI ---
ANTHROPIC_API_KEY=your_key_here
# Model ids (current generation). Override per-task as needed.
ANTHROPIC_PLANNER_MODEL=claude-sonnet-5
ANTHROPIC_EXECUTOR_MODEL=claude-sonnet-5

# --- GitHub (later phases) ---
GITHUB_TOKEN=
